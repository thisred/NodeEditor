<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NodeEditor.ViewModels"
             xmlns:conv="clr-namespace:NodeEditor.Converters"
             x:Class="NodeEditor.MainPage"
             BackgroundColor="#1E1E1E">

    <ContentPage.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:ZoomToPercentConverter x:Key="ZoomPercent" />

        <!-- 全局按钮样式：用 Opacity 实现 pressed/hover 反馈，不覆盖各按钮原色 -->
        <Style TargetType="Button" ApplyToDerivedTypes="True">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1.0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.85" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.55" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- ═══ MAUI 原生标题栏 ═══ -->
        <TitleBar x:Key="AppTitleBar"
                  Title=""
                  BackgroundColor="#2D2D44"
                  ForegroundColor="White"
                  HeightRequest="32">
            <TitleBar.LeadingContent>
                <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label Text="NodeEditor" TextColor="White" FontSize="12" FontAttributes="Bold"
                           VerticalTextAlignment="Center" Margin="8,0,12,0" />
                    <Button Text="文件(F)" Style="{StaticResource TitleBarMenuButton}" Clicked="ShowMenu" />
                    <Button Text="编辑(E)" Style="{StaticResource TitleBarMenuButton}" Clicked="ShowMenu" />
                    <Button Text="节点(N)" Style="{StaticResource TitleBarMenuButton}" Clicked="ShowMenu" />
                    <Button Text="视图(V)" Style="{StaticResource TitleBarMenuButton}" Clicked="ShowMenu" />
                </HorizontalStackLayout>
            </TitleBar.LeadingContent>
            <TitleBar.Content>
                <Button Text="▶" Style="{StaticResource TitleBarExecButton}"
                        HorizontalOptions="Center" VerticalOptions="Center" />
            </TitleBar.Content>
        </TitleBar>

    </ContentPage.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="*,150" ColumnDefinitions="220,*,270">
        <!-- ═══ 左栏：文件浏览器 ═══ -->
        <!-- ZIndex 高于画布：节点平移到画布外时会溢出到侧栏屏幕区域（MAUI 的 Clip 只裁剪渲染、
             不裁剪命中测试），提高 ZIndex 让侧栏挡住这些不可见节点的点击 -->
        <Border x:Name="FileSidebar" Grid.Row="0" Grid.Column="0"
                BackgroundColor="#252526" Stroke="#3F3F3F" StrokeThickness="0"
                IsVisible="True" ZIndex="1">
            <Grid RowDefinitions="Auto,*">
                <!-- 标题 -->
                <Border Grid.Row="0" Padding="8,6" BackgroundColor="#2D2D2D"
                        Stroke="#3F3F3F" StrokeThickness="0">
                    <Grid>
                        <Label Text="文件" TextColor="#89DCEB" FontSize="12" FontAttributes="Bold"
                               VerticalTextAlignment="Center" />
                        <Button Text="◀" FontSize="10" BackgroundColor="Transparent" TextColor="#888"
                                HorizontalOptions="End" Padding="4,0" Clicked="CollapseSidebar_Click"
                                BorderWidth="0" />
                    </Grid>
                </Border>

                <!-- 文件列表 -->
                <CollectionView Grid.Row="1" ItemsSource="{Binding FileExplorer.Files}"
                                SelectionMode="Single"
                                SelectedItem="{Binding FileExplorer.ActiveFile, Mode=TwoWay}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItemViewModel">
                            <Grid Padding="10,4">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="●" TextColor="#E2C08D" FontSize="10"
                                           IsVisible="{Binding IsDirty}" />
                                    <Label Text="{Binding FileName}" TextColor="#CCC" FontSize="12" />
                                </HorizontalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- 左栏折叠后展开按钮 -->
        <Button x:Name="ExpandSidebarBtn" Grid.Row="0" Grid.Column="1"
                Text="▶" FontSize="12" BackgroundColor="#252526" TextColor="#888"
                HorizontalOptions="Start" VerticalOptions="Start"
                Padding="6,8" Clicked="ExpandSidebar_Click" BorderWidth="0"
                IsVisible="False" ZIndex="10" />

        <!-- ═══ 画布区域 ═══ -->
        <Grid Grid.Row="0" Grid.Column="1" x:Name="CanvasArea">

            <!-- 网格背景层 -->
            <GraphicsView x:Name="GridBackgroundView" InputTransparent="True" />

            <!-- 连线层 -->
            <GraphicsView x:Name="ConnectionsView" InputTransparent="True" />

            <!-- 画布变换容器 -->
            <AbsoluteLayout x:Name="CanvasContainer">
            </AbsoluteLayout>

            <!-- 选框层 -->
            <AbsoluteLayout x:Name="SelectionLayer" InputTransparent="True">
                <BoxView x:Name="SelectionRect" Color="#3399FF" Opacity="0.15"
                         IsVisible="False" InputTransparent="True" />
            </AbsoluteLayout>

            <!-- 操作提示 -->
            <Border HorizontalOptions="Start" VerticalOptions="Start"
                    Margin="12" BackgroundColor="#2D2D2D" Padding="10,5" Opacity="0.7"
                    StrokeShape="RoundRectangle 4" Stroke="Transparent">
                <Label Text="右键创建节点 · 左键拖拽框选 · 中键平移画布 · Ctrl+点击多选 · Ctrl+C/V 复制粘贴 · Del 删除 · F11 全屏"
                       TextColor="#777" FontSize="11" />
            </Border>

            <!-- 缩放指示器 -->
            <Border HorizontalOptions="End" VerticalOptions="Start"
                    Margin="12" BackgroundColor="#2D2D2D" Padding="8,3" Opacity="0.8"
                    StrokeShape="RoundRectangle 4" Stroke="Transparent">
                <Label Text="{Binding Zoom, Converter={StaticResource ZoomPercent}}"
                       TextColor="#888" FontSize="11" />
            </Border>

            <!-- 小地图 -->
            <Border x:Name="MinimapBorder" HorizontalOptions="End" VerticalOptions="End"
                    Margin="12" WidthRequest="180" HeightRequest="120"
                    BackgroundColor="#252526" Stroke="#3F3F3F" StrokeThickness="1"
                    Opacity="0.9" IsVisible="False">
                <GraphicsView x:Name="MinimapView" InputTransparent="False" />
            </Border>

            <!-- 搜索弹窗覆盖层 -->
            <Grid x:Name="SearchOverlay" IsVisible="False" InputTransparent="False">
                <BoxView Color="Transparent" InputTransparent="False">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SearchOverlay_Tapped" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <AbsoluteLayout x:Name="SearchContainer" />
            </Grid>
        </Grid>

        <!-- ═══ 右栏：属性面板 ═══ -->
        <!-- ZIndex 高于画布，理由同左栏侧边栏 -->
        <Border x:Name="PropertyPanel" Grid.Row="0" Grid.Column="2"
                BackgroundColor="#252526" Stroke="#3F3F3F" StrokeThickness="0"
                IsVisible="True" ZIndex="1">
            <Grid RowDefinitions="Auto,Auto,*">
                <!-- 标题 -->
                <Border Grid.Row="0" Padding="12,6" BackgroundColor="#2D2D2D"
                        Stroke="#3F3F3F" StrokeThickness="0">
                    <Grid>
                        <Label Text="属性" TextColor="#89DCEB" FontSize="12" FontAttributes="Bold"
                               VerticalTextAlignment="Center" />
                        <Button Text="▶" FontSize="10" BackgroundColor="Transparent" TextColor="#888"
                                HorizontalOptions="End" Padding="4,0" Clicked="CollapseProperty_Click"
                                BorderWidth="0" />
                    </Grid>
                </Border>

                <!-- 选中节点信息 -->
                <VerticalStackLayout Grid.Row="1" Padding="12,8" Spacing="2"
                                     IsVisible="{Binding HasSelectedNode}">
                    <Label Text="{Binding SelectedNode.DisplayName}"
                           TextColor="White" FontSize="14" FontAttributes="Bold" />
                    <Label Text="{Binding SelectedNode.Category}"
                           TextColor="#888" FontSize="11" />
                    <Label Text="{Binding SelectedNode.Description}"
                           TextColor="#777" FontSize="11" LineBreakMode="WordWrap" />
                    <BoxView HeightRequest="1" Color="#3F3F3F" Margin="0,8" />
                    <Label Text="可编辑属性" TextColor="#AAA" FontSize="11" />
                </VerticalStackLayout>

                <!-- 属性列表 -->
                <Grid Grid.Row="2" Padding="12,0">
                    <ScrollView>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedNode.Properties}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:NodePropertyViewModel">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding DisplayName}" TextColor="#BBB" FontSize="12" />
                                        <!-- 布尔：开关 -->
                                        <Switch IsToggled="{Binding BoolValue, Mode=TwoWay}"
                                                IsVisible="{Binding IsBool}" />
                                        <!-- 枚举：Picker -->
                                        <Picker ItemsSource="{Binding EnumValues}"
                                                SelectedItem="{Binding ValueText, Mode=TwoWay}"
                                                IsVisible="{Binding IsEnum}"
                                                BackgroundColor="#3A3A3A" TextColor="#CCC" />
                                        <!-- 其他：文本框 -->
                                        <Entry Text="{Binding ValueText, Mode=TwoWay}"
                                               IsVisible="{Binding IsBool, Converter={StaticResource InverseBool}}"
                                               BackgroundColor="#3A3A3A" TextColor="#CCC"
                                               FontSize="12" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- 未选中提示 -->
                    <Label Text="选择一个节点查看属性"
                           TextColor="#666" FontSize="12"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           IsVisible="{Binding HasSelectedNode, Converter={StaticResource InverseBool}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 右栏折叠后展开按钮 -->
        <Button x:Name="ExpandPropertyBtn" Grid.Row="0" Grid.Column="1"
                Text="◀" FontSize="12" BackgroundColor="#252526" TextColor="#888"
                HorizontalOptions="End" VerticalOptions="Start"
                Padding="6,8" Clicked="ExpandProperty_Click" BorderWidth="0"
                IsVisible="False" ZIndex="10" />

        <!-- ═══ 底部日志面板 ═══ -->
        <Border x:Name="LogPanel" Grid.Row="1" Grid.ColumnSpan="3" BackgroundColor="#252526"
                Stroke="#3F3F3F" StrokeThickness="0" IsVisible="True">
            <Grid RowDefinitions="Auto,*">
                <!-- 日志标题栏 -->
                <Border Grid.Row="0" Padding="10,5" BackgroundColor="#2D2D2D"
                        Stroke="#3F3F3F" StrokeThickness="0">
                    <Grid>
                        <HorizontalStackLayout Spacing="8">
                            <Label x:Name="LogToggleIndicator" Text="▼" TextColor="#888" FontSize="12"
                                   VerticalTextAlignment="Center" />
                            <Label Text="Console" TextColor="#888" FontSize="11" FontAttributes="Bold"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Button Text="🗑" FontSize="11" BackgroundColor="Transparent" TextColor="#AAA"
                                HorizontalOptions="End" Padding="6,2" Clicked="ClearLog_Click" BorderWidth="0" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="LogHeader_Tapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- 日志内容（用 ScrollView+Label 代替 Editor，避免原生 TextBox 边框白线） -->
                <ScrollView x:Name="LogScroll" Grid.Row="1" BackgroundColor="#1E1E1E"
                            IsVisible="True" VerticalScrollBarVisibility="Always">
                    <Label x:Name="LogOutput" Text="" TextColor="#CCC"
                           FontFamily="Consolas" FontSize="12"
                           Padding="6,4" LineBreakMode="WordWrap" />
                </ScrollView>

            </Grid>
        </Border>

        <!-- 状态标签：窗口最左下角（声明在最后 → 渲染在最上层，不被 Console 遮挡） -->
        <Label x:Name="TitleBarStatusLabel" Grid.Row="1" Grid.Column="0"
               TextColor="#999999" FontSize="11"
               VerticalOptions="End" HorizontalOptions="Start"
               Margin="8,0,0,4" ZIndex="100" InputTransparent="True" />
    </Grid>
</ContentPage>