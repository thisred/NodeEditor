<UserControl x:Class="NodeEditor.Wpf.NodeSearchWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300"
             Height="400"
             KeyDown="Panel_KeyDown">
    <UserControl.Resources>
        <!-- 暗色细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="3" Margin="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#555" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#888" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="6" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="#2D2D2D" CornerRadius="8" BorderBrush="#555" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <DockPanel>
            <!-- 顶部：标题 + 搜索框 -->
            <Border DockPanel.Dock="Top" Padding="12,10,12,8"
                    BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6" Height="24">
                        <Border x:Name="BackButton" DockPanel.Dock="Left"
                                Background="Transparent" CornerRadius="4"
                                Width="24" Height="24" Margin="-6,0,4,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="BackButton_Click"
                                Visibility="Collapsed"
                                ToolTip="返回分类">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#37373D" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Path x:Name="BackArrow" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M6 0 L0 7 L6 14 M0 7 L14 7">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="#999" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                <Setter Property="Stroke" Value="#89DCEB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Border>
                        <TextBlock x:Name="TitleText" Text="选择分类"
                                   Foreground="#89DCEB" FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="SearchBox"
                             Background="#1E1E1E" Foreground="#CCC"
                             BorderBrush="#555" BorderThickness="1" Padding="8,5"
                             FontSize="13"
                             CaretBrush="#89DCEB"
                             TextChanged="SearchBox_TextChanged" />
                </StackPanel>
            </Border>

            <!-- 底部状态栏 -->
            <Border DockPanel.Dock="Bottom" Padding="12,4"
                    BorderBrush="#3F3F3F" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" Foreground="#666" FontSize="11" />
            </Border>

            <!-- 主内容区域：分类列表 / 节点列表 -->
            <Grid>
                <!-- 分类列表 -->
                <ListBox x:Name="CategoryList"
                         Background="Transparent" BorderThickness="0"
                         Padding="4"
                         SelectionChanged="CategoryList_SelectionChanged"
                         MouseDoubleClick="CategoryList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2,1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="10,7"
                                                HorizontalAlignment="Stretch">
                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#37373D" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#0E639C" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 节点列表 -->
                <ListBox x:Name="NodeList"
                         Background="Transparent" BorderThickness="0"
                         Padding="4"
                         Visibility="Collapsed"
                         PreviewMouseLeftButtonDown="NodeList_PreviewMouseLeftButtonDown"
                         MouseDoubleClick="NodeList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2,1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="10,6"
                                                HorizontalAlignment="Stretch">
                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#37373D" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#0E639C" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayName}" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>