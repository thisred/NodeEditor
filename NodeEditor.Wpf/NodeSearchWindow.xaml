<Window x:Class="NodeEditor.Wpf.NodeSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Width="300"
        Height="400"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Border Background="#2D2D2D" CornerRadius="8" BorderBrush="#555" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <DockPanel>
            <!-- 顶部：标题 + 搜索框 -->
            <Border DockPanel.Dock="Top" Padding="12,10,12,8"
                    BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button x:Name="BackButton" Content="← 返回"
                                DockPanel.Dock="Left"
                                Background="Transparent" Foreground="#89DCEB"
                                BorderThickness="0" FontSize="11"
                                Cursor="Hand"
                                Click="BackButton_Click"
                                Visibility="Collapsed"
                                Padding="0,2" />
                        <TextBlock x:Name="TitleText" Text="选择分类"
                                   Foreground="#89DCEB" FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="SearchBox"
                             Background="#1E1E1E" Foreground="#CCC"
                             BorderBrush="#555" BorderThickness="1" Padding="8,5"
                             FontSize="13"
                             CaretBrush="#89DCEB"
                             TextChanged="SearchBox_TextChanged" />
                </StackPanel>
            </Border>

            <!-- 底部状态栏 -->
            <Border DockPanel.Dock="Bottom" Padding="12,4"
                    BorderBrush="#3F3F3F" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" Foreground="#666" FontSize="11" />
            </Border>

            <!-- 分类列表 -->
            <ListBox x:Name="CategoryList"
                     Background="Transparent" BorderThickness="0"
                     Padding="4"
                     SelectionChanged="CategoryList_SelectionChanged"
                     MouseDoubleClick="CategoryList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="2,1" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="10,7">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#37373D" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#0E639C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding}" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 节点列表 -->
            <ListBox x:Name="NodeList"
                     Background="Transparent" BorderThickness="0"
                     Padding="4"
                     Visibility="Collapsed"
                     PreviewMouseLeftButtonDown="NodeList_PreviewMouseLeftButtonDown"
                     MouseDoubleClick="NodeList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="2,1" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="10,6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#37373D" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#0E639C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayName}" Foreground="#CCC" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>