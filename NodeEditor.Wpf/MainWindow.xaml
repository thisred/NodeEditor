<Window x:Class="NodeEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NodeEditor.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Node Editor" Height="700" Width="1200"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 节点模板 -->
        <DataTemplate DataType="{x:Type vm:NodeViewModel}">
            <Border Width="180" Margin="0"
                    CornerRadius="5"
                    MouseLeftButtonDown="Node_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#555" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="#2D2D2D" Opacity="0.97" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC" />
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#333F5A" Opacity="0.97" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#007ACC" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- 节点头部 -->
                    <Border CornerRadius="5,5,0,0" Padding="10,6"
                            Background="{Binding Color}"
                            MouseLeftButtonDown="NodeHeader_MouseLeftButtonDown">
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- 端口区域 -->
                    <Grid Margin="2,4,2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 输入端口（左列） -->
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding InputPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2" Height="16">
                                        <Ellipse Fill="{Binding TypeColor}"
                                                 Stroke="#888" StrokeThickness="1"
                                                 Margin="-7,0,0,0"
                                                 Tag="{Binding}"
                                                 Loaded="Port_Loaded" Unloaded="Port_Unloaded"
                                                 MouseLeftButtonDown="OutputPort_MouseLeftButtonDown"
                                                 MouseLeftButtonUp="InputPort_MouseLeftButtonUp"
                                                 Cursor="Cross">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Width" Value="12" />
                                                    <Setter Property="Height" Value="12" />
                                                    <Setter Property="ToolTip" Value="{Binding TypeDisplayName}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExec}" Value="True">
                                                            <Setter Property="Width" Value="14" />
                                                            <Setter Property="Height" Value="14" />
                                                            <Setter Property="ToolTip" Value="Exec" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="#CCC" FontSize="11"
                                                   VerticalAlignment="Center" Margin="2,0,0,0" />
                                        <TextBlock Text="{Binding TypeDisplayName}"
                                                   Foreground="{Binding TypeColor}" FontSize="9"
                                                   VerticalAlignment="Center" Margin="3,1,0,0"
                                                   Visibility="{Binding IsExec, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 输出端口（右列） -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding OutputPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,2" Height="16">
                                        <TextBlock Text="{Binding TypeDisplayName}"
                                                   Foreground="{Binding TypeColor}" FontSize="9"
                                                   VerticalAlignment="Center" Margin="0,1,3,0"
                                                   Visibility="{Binding IsExec, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="#CCC" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,2,0" />
                                        <Ellipse Fill="{Binding TypeColor}"
                                                 Stroke="#888" StrokeThickness="1"
                                                 Margin="0,0,-7,0"
                                                 Tag="{Binding}"
                                                 Loaded="Port_Loaded" Unloaded="Port_Unloaded"
                                                 MouseLeftButtonDown="OutputPort_MouseLeftButtonDown"
                                                 MouseLeftButtonUp="InputPort_MouseLeftButtonUp"
                                                 Cursor="Cross">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Width" Value="12" />
                                                    <Setter Property="Height" Value="12" />
                                                    <Setter Property="ToolTip" Value="{Binding TypeDisplayName}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExec}" Value="True">
                                                            <Setter Property="Width" Value="14" />
                                                            <Setter Property="Height" Value="14" />
                                                            <Setter Property="ToolTip" Value="Exec" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 连线模板 -->
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <Path Data="{Binding PathData}"
                  Stroke="#569CD6" StrokeThickness="2.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  MouseRightButtonDown="Connection_MouseRightButtonDown"
                  Cursor="Hand" />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top" FontSize="12">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开文件夹..." Command="{Binding FileExplorer.OpenFolderCommand}" />
                <MenuItem Header="新建图..." Command="{Binding FileExplorer.NewGraphCommand}" />
                <MenuItem Header="保存" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="导出 JSON..." Command="{Binding ExportCommand}" />
                <MenuItem Header="导入 JSON..." Command="{Binding ImportCommand}" />
                <Separator />
                <MenuItem Header="清空画布" Command="{Binding ClearCommand}" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="复制" Click="Copy_Click" InputGestureText="Ctrl+C" />
                <MenuItem Header="粘贴" Click="Paste_Click" InputGestureText="Ctrl+V" />
                <Separator />
                <MenuItem Header="删除选中" Command="{Binding DeleteSelectedCommand}" InputGestureText="Del" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 Node Editor" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#2D2D2D" Padding="8,4"
                BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
            <Grid>
                <Button Command="{Binding ExecuteCommand}"
                        HorizontalAlignment="Center"
                        Width="25" Height="20"
                        Background="#3A6B3A" Foreground="#FFF"
                        FontSize="12" FontWeight="Normal"
                        ToolTip="Play"
                        Content="▶" />
                <TextBlock x:Name="StatusText" Foreground="#888" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- 主区域 + 底部日志面板（可拖拽调整大小） -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="150" MinHeight="28" x:Name="LogRow" />
            </Grid.RowDefinitions>

            <!-- 水平 GridSplitter（日志面板上方） -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="#2D2D2D" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows" x:Name="LogSplitter"
                          Cursor="SizeNS">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="#1E1E1E" BorderBrush="#3F3F3F" BorderThickness="0,1,0,1">
                            <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Width="40" Height="2" Fill="#555" RadiusX="1" RadiusY="1" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- 底部日志面板 -->
            <Border Grid.Row="2" x:Name="LogPanel" Background="#252526"
                    BorderBrush="#3F3F3F" BorderThickness="0,0,0,0">
                <DockPanel>
                    <!-- 日志面板标题栏 -->
                    <Border DockPanel.Dock="Top" Padding="10,5" Background="#2D2D2D"
                            BorderBrush="#3F3F3F" BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="LogHeader_MouseLeftButtonDown" Cursor="Hand">
                        <DockPanel>
                            <TextBlock x:Name="LogToggleIndicator" Text="▼" DockPanel.Dock="Right"
                                       Foreground="#888" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Text="Console" Foreground="#888" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <!-- 日志内容 -->
                    <Grid x:Name="LogContent">
                        <TextBox x:Name="LogOutput" IsReadOnly="True"
                                 Background="#1E1E1E" Foreground="#CCC" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                        <Button Click="ClearLogButton_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#2D2D2D" BorderBrush="#555"
                                Padding="6,5" Cursor="Hand" Margin="0,12,12,0"
                                Opacity="0.85" ToolTip="Clear">
                            <Path Stroke="#AAA" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M2 2 L2 14 L12 14 L12 2 M0 2 L14 2 M5 2 L5 0 L9 0 L9 2 M5 5 L5 11 M7 5 L7 11 M9 5 L9 11" />
                        </Button>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 主区域：五栏（文件栏 | splitter | 画布 | splitter | 属性面板） -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="40" x:Name="LeftCol" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="270" MinWidth="40" x:Name="RightCol" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：文件浏览器（可折叠） -->
                <Border Grid.Column="0" x:Name="FileSidebar"
                        Background="#252526">
                    <DockPanel>
                        <!-- 文件栏标题栏 -->
                        <Border DockPanel.Dock="Top" Padding="8,6" Background="#2D2D2D"
                                BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Click="CollapseSidebar_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#888" FontSize="12" Cursor="Hand"
                                        Padding="4,0" ToolTip="折叠侧栏"
                                        Content="◀" />
                                <TextBlock Text="文件" Foreground="#89DCEB" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- 文件栏工具按钮 -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,0">
                            <Button Click="OpenFolder_Click" Background="#3A3A3A" Foreground="#CCC"
                                    Padding="6,3" Margin="0,0,3,0" FontSize="11" Cursor="Hand"
                                    ToolTip="打开文件夹" Content="📂 打开" />
                            <Button Click="NewGraph_Click" Background="#3A3A3A" Foreground="#CCC"
                                    Padding="6,3" FontSize="11" Cursor="Hand"
                                    ToolTip="新建图" Content="✚ 新建" />
                        </StackPanel>

                        <!-- 工作区路径显示 -->
                        <TextBlock DockPanel.Dock="Top" Margin="8,4,8,2"
                                   Text="{Binding FileExplorer.WorkspacePath}"
                                   Foreground="#666" FontSize="10" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding FileExplorer.HasWorkspace, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 文件列表 -->
                        <ListBox x:Name="FileList" ItemsSource="{Binding FileExplorer.Files}"
                                 Background="Transparent" BorderThickness="0"
                                 Margin="0,4,0,0"
                                 SelectedItem="{Binding FileExplorer.ActiveFile, Mode=TwoWay}"
                                 PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2D2D2D" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="#37373D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="●" Foreground="#E2C08D" FontSize="10" Margin="0,0,4,0"
                                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding FileName}" Foreground="#CCC" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 左侧垂直 GridSplitter -->
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns" x:Name="LeftSplitter"
                              Cursor="SizeWE">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="#1E1E1E" BorderBrush="#3F3F3F" BorderThickness="0,0,0,0">
                                <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Width="2" Height="40" Fill="#555" RadiusX="1" RadiusY="1" />
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- 画布 -->
                <Grid Grid.Column="2" x:Name="CanvasArea"
                      Background="#1E1E1E"
                      ClipToBounds="True"
                      MouseLeftButtonDown="CanvasArea_MouseLeftButtonDown"
                      MouseLeftButtonUp="CanvasArea_MouseLeftButtonUp"
                      MouseMove="CanvasArea_MouseMove"
                      MouseWheel="CanvasArea_MouseWheel"
                      MouseRightButtonDown="CanvasArea_MouseRightButtonDown">
                    <!-- 画布变换容器 -->
                    <Grid x:Name="CanvasContainer" RenderTransformOrigin="0,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                                <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- 连线层 -->
                        <ItemsControl ItemsSource="{Binding Connections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas IsHitTestVisible="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- 临时连线（拖拽中） -->
                        <Canvas IsHitTestVisible="False">
                            <Path Data="{Binding PendingPathData}"
                                  Stroke="#FFD700" StrokeThickness="2"
                                  StrokeDashArray="4,2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="{Binding HasPendingConnection, Converter={StaticResource BoolToVisibility}}" />
                        </Canvas>

                        <!-- 节点层 -->
                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Grid>

                    <!-- 选框层（屏幕坐标，不随画布缩放） -->
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionRect"
                                   Stroke="#3399FF" StrokeThickness="1.5"
                                   Fill="#3399FF" Opacity="0.15"
                                   Visibility="Collapsed" />
                    </Canvas>

                    <!-- 操作提示 -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="12,12,0,0" Background="#2D2D2D" CornerRadius="4"
                            Padding="10,5" Opacity="0.7">
                        <TextBlock Foreground="#777" FontSize="11">
                            <Run Text="右键创建节点 · 左键拖拽框选 · Ctrl+点击多选 · Ctrl+C/V 复制粘贴 · Del 删除 · F11 全屏" />
                        </TextBlock>
                    </Border>

                    <!-- 缩放指示器 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,12,12,0" Background="#2D2D2D" CornerRadius="4"
                            Padding="8,3" Opacity="0.8">
                        <TextBlock Foreground="#888" FontSize="11">
                            <Run Text="缩放: " />
                            <Run Text="{Binding Zoom, StringFormat=P0}" />
                        </TextBlock>
                    </Border>

                    <!-- 小地图 -->
                    <Border x:Name="MinimapBorder"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,12,12" Width="180" Height="120"
                            Background="#252526" CornerRadius="4"
                            BorderBrush="#3F3F3F" BorderThickness="1"
                            Opacity="0.9" ClipToBounds="True"
                            MouseLeftButtonDown="Minimap_MouseLeftButtonDown"
                            MouseMove="Minimap_MouseMove"
                            MouseLeftButtonUp="Minimap_MouseLeftButtonUp">
                        <Canvas x:Name="MinimapCanvas" />
                    </Border>
                </Grid>

                <!-- 左栏折叠后展开按钮 -->
                <Button Grid.Column="2" x:Name="ExpandSidebarBtn" Click="ExpandSidebar_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="0,38,0,0"
                        Background="#252526" BorderBrush="#3F3F3F" BorderThickness="0,0,1,0"
                        Foreground="#888" FontSize="14" Cursor="Hand"
                        Padding="6,8" ToolTip="展开文件栏" Content="▶"
                        Visibility="Collapsed" />
                <!-- 右栏折叠后展开按钮 -->
                <Button Grid.Column="2" x:Name="ExpandPropertyBtn" Click="ExpandProperty_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,38,0,0"
                        Background="#252526" BorderBrush="#3F3F3F" BorderThickness="1,0,0,0"
                        Foreground="#888" FontSize="14" Cursor="Hand"
                        Padding="6,8" ToolTip="展开属性栏" Content="◀"
                        Visibility="Collapsed" />

                <!-- 右侧垂直 GridSplitter -->
                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns" x:Name="RightSplitter"
                              Cursor="SizeWE">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="#1E1E1E">
                                <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Width="2" Height="40" Fill="#555" RadiusX="1" RadiusY="1" />
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- 右栏：属性面板 -->
                <Border Grid.Column="4" x:Name="PropertyPanel" Background="#252526">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,6" Background="#2D2D2D"
                                BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Click="CollapseProperty_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#888" FontSize="12" Cursor="Hand"
                                        Padding="4,0" ToolTip="折叠属性栏"
                                        Content="▶" />
                                <TextBlock Text="属性" Foreground="#89DCEB"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- 选中节点信息 -->
                        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8"
                                    Visibility="{Binding HasSelectedNode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SelectedNode.DisplayName}"
                                       Foreground="#FFF" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectedNode.Category}"
                                       Foreground="#888" FontSize="11" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding SelectedNode.Description}"
                                       Foreground="#777" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <Separator Margin="0,8" Background="#3F3F3F" />
                            <TextBlock Text="可编辑属性" Foreground="#AAA" FontSize="11" Margin="0,4,0,4" />
                        </StackPanel>

                        <!-- 属性列表 / 未选中提示（Grid 叠层，作为 DockPanel 最后子元素填满剩余空间） -->
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,0,12,8">
                                <ItemsControl ItemsSource="{Binding SelectedNode.Properties}" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,6" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#BBB" FontSize="12" />
                                                <!-- 枚举：下拉框 -->
                                                <ComboBox ItemsSource="{Binding EnumValues}"
                                                          SelectedItem="{Binding ValueText}"
                                                          Visibility="{Binding IsEnum, Converter={StaticResource BoolToVisibility}}"
                                                          HorizontalAlignment="Stretch"
                                                          Margin="0,2,0,0" Background="#3A3A3A" Foreground="#CCC" />
                                                <!-- 布尔：复选框 -->
                                                <CheckBox IsChecked="{Binding BoolValue}"
                                                          Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}"
                                                          HorizontalAlignment="Stretch"
                                                          Margin="0,2,0,0" Foreground="#CCC" Content="" />
                                                <!-- 其他：文本框 -->
                                                <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsBool, Converter={StaticResource InverseBoolToVisibility}}"
                                                         HorizontalAlignment="Stretch"
                                                         Margin="0,2,0,0" Background="#3A3A3A" Foreground="#CCC"
                                                         BorderBrush="#555" Padding="6,3" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 未选中提示 -->
                            <TextBlock Text="选择一个节点查看属性"
                                       Foreground="#666" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasSelectedNode, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>