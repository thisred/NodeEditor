<Window x:Class="NodeEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NodeEditor.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Node Editor" Height="700" Width="1200"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 节点模板 -->
        <DataTemplate DataType="{x:Type vm:NodeViewModel}">
            <Border Width="180" Margin="0"
                    BorderBrush="#555" BorderThickness="1"
                    CornerRadius="5"
                    MouseLeftButtonDown="Node_MouseLeftButtonDown">
                <Border.Background>
                    <SolidColorBrush Color="#2D2D2D" Opacity="0.97" />
                </Border.Background>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- 节点头部 -->
                    <Border CornerRadius="5,5,0,0" Padding="10,6"
                            Background="{Binding Color}"
                            MouseLeftButtonDown="NodeHeader_MouseLeftButtonDown">
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- 端口区域 -->
                    <Grid Margin="2,4,2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 输入端口（左列） -->
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding InputPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2" Height="16">
                                        <Ellipse Stroke="#888" StrokeThickness="1"
                                                 Margin="-7,0,0,0"
                                                 Tag="{Binding}"
                                                 Loaded="Port_Loaded" Unloaded="Port_Unloaded"
                                                 MouseLeftButtonDown="OutputPort_MouseLeftButtonDown"
                                                 MouseLeftButtonUp="InputPort_MouseLeftButtonUp"
                                                 Cursor="Cross">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Width" Value="12" />
                                                    <Setter Property="Height" Value="12" />
                                                    <Setter Property="Fill" Value="#6DBE45" />
                                                    <Setter Property="ToolTip" Value="{Binding PortTypeName}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExec}" Value="True">
                                                            <Setter Property="Fill" Value="#F0F0F0" />
                                                            <Setter Property="Width" Value="14" />
                                                            <Setter Property="Height" Value="14" />
                                                            <Setter Property="ToolTip" Value="Exec" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="#CCC" FontSize="11"
                                                   VerticalAlignment="Center" Margin="2,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 输出端口（右列） -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding OutputPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,2" Height="16">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="#CCC" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,2,0" />
                                        <Ellipse Stroke="#888" StrokeThickness="1"
                                                 Margin="0,0,-7,0"
                                                 Tag="{Binding}"
                                                 Loaded="Port_Loaded" Unloaded="Port_Unloaded"
                                                 MouseLeftButtonDown="OutputPort_MouseLeftButtonDown"
                                                 MouseLeftButtonUp="InputPort_MouseLeftButtonUp"
                                                 Cursor="Cross">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Width" Value="12" />
                                                    <Setter Property="Height" Value="12" />
                                                    <Setter Property="Fill" Value="#569CD6" />
                                                    <Setter Property="ToolTip" Value="{Binding PortTypeName}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExec}" Value="True">
                                                            <Setter Property="Fill" Value="#F0F0F0" />
                                                            <Setter Property="Width" Value="14" />
                                                            <Setter Property="Height" Value="14" />
                                                            <Setter Property="ToolTip" Value="Exec" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 连线模板 -->
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <Path Data="{Binding PathData}"
                  Stroke="#569CD6" StrokeThickness="2.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  MouseRightButtonDown="Connection_MouseRightButtonDown"
                  Cursor="Hand" />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#2D2D2D" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Node Editor" Foreground="#89DCEB" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,20,0" />
                <Button Content="导出 JSON" Command="{Binding ExportCommand}"
                        Margin="0,0,8,0" Padding="12,4" Background="#3A3A3A" Foreground="#CCC" />
                <Button Content="导入 JSON" Command="{Binding ImportCommand}"
                        Margin="0,0,8,0" Padding="12,4" Background="#3A3A3A" Foreground="#CCC" />
                <Button Content="执行图" Command="{Binding ExecuteCommand}"
                        Margin="0,0,8,0" Padding="12,4" Background="#3A6B3A" Foreground="#FFF" />
                <Button Content="清空" Command="{Binding ClearCommand}"
                        Margin="0,0,8,0" Padding="12,4" Background="#6B3A3A" Foreground="#FFF" />
                <TextBlock x:Name="StatusText" Foreground="#888" FontSize="11"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 主区域：两栏（画布 + 属性面板） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <!-- 画布 -->
            <Grid Grid.Column="0" x:Name="CanvasArea"
                  Background="#1E1E1E"
                  ClipToBounds="True"
                  MouseLeftButtonDown="CanvasArea_MouseLeftButtonDown"
                  MouseLeftButtonUp="CanvasArea_MouseLeftButtonUp"
                  MouseMove="CanvasArea_MouseMove"
                  MouseWheel="CanvasArea_MouseWheel"
                  MouseRightButtonDown="CanvasArea_MouseRightButtonDown">
                <!-- 画布变换容器 -->
                <Grid x:Name="CanvasContainer" RenderTransformOrigin="0,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                            <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- 连线层 -->
                    <ItemsControl ItemsSource="{Binding Connections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsHitTestVisible="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- 临时连线（拖拽中） -->
                    <Path Data="{Binding PendingPathData}"
                          Stroke="#FFD700" StrokeThickness="2"
                          StrokeDashArray="4,2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Visibility="{Binding HasPendingConnection, Converter={StaticResource BoolToVisibility}}"
                          IsHitTestVisible="False" />

                    <!-- 节点层 -->
                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>

                <!-- 选框层（屏幕坐标，不随画布缩放） -->
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="SelectionRect"
                               Stroke="#3399FF" StrokeThickness="1.5"
                               Fill="#3399FF" Opacity="0.15"
                               Visibility="Collapsed" />
                </Canvas>

                <!-- 操作提示 -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="12,12,0,0" Background="#2D2D2D" CornerRadius="4"
                        Padding="10,5" Opacity="0.7">
                    <TextBlock Foreground="#777" FontSize="11">
                        <Run Text="右键创建节点 · 左键拖拽框选 · Ctrl+点击多选 · Ctrl+C/V 复制粘贴 · Del 删除 · F11 全屏" />
                    </TextBlock>
                </Border>

                <!-- 缩放指示器 -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,12,0" Background="#2D2D2D" CornerRadius="4"
                        Padding="8,3" Opacity="0.8">
                    <TextBlock Foreground="#888" FontSize="11">
                        <Run Text="缩放: " />
                        <Run Text="{Binding Zoom, StringFormat=P0}" />
                    </TextBlock>
                </Border>

                <!-- 小地图 -->
                <Border x:Name="MinimapBorder"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,12,12" Width="180" Height="120"
                        Background="#252526" CornerRadius="4"
                        BorderBrush="#3F3F3F" BorderThickness="1"
                        Opacity="0.9" ClipToBounds="True"
                        MouseLeftButtonDown="Minimap_MouseLeftButtonDown"
                        MouseMove="Minimap_MouseMove"
                        MouseLeftButtonUp="Minimap_MouseLeftButtonUp">
                    <Canvas x:Name="MinimapCanvas" />
                </Border>
            </Grid>

            <!-- 右栏：属性面板 -->
            <Border Grid.Column="1" Background="#252526" BorderBrush="#3F3F3F" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="属性" Foreground="#89DCEB"
                               FontSize="13" FontWeight="SemiBold" Margin="12,10,0,6" />

                    <!-- 选中节点信息 -->
                    <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8"
                                Visibility="{Binding HasSelectedNode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SelectedNode.DisplayName}"
                                   Foreground="#FFF" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedNode.Category}"
                                   Foreground="#888" FontSize="11" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SelectedNode.Description}"
                                   Foreground="#777" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Separator Margin="0,8" Background="#3F3F3F" />
                        <TextBlock Text="可编辑属性" Foreground="#AAA" FontSize="11" Margin="0,4,0,4" />
                    </StackPanel>

                    <!-- 属性列表 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,0,12,8">
                        <ItemsControl ItemsSource="{Binding SelectedNode.Properties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#BBB" FontSize="12" />
                                        <!-- 枚举：下拉框 -->
                                        <ComboBox ItemsSource="{Binding EnumValues}"
                                                  SelectedItem="{Binding ValueText}"
                                                  Visibility="{Binding IsEnum, Converter={StaticResource BoolToVisibility}}"
                                                  Margin="0,2,0,0" Background="#3A3A3A" Foreground="#CCC" />
                                        <!-- 布尔：复选框 -->
                                        <CheckBox IsChecked="{Binding BoolValue}"
                                                  Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}"
                                                  Margin="0,2,0,0" Foreground="#CCC" Content="" />
                                        <!-- 其他：文本框 -->
                                        <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsBool, Converter={StaticResource InverseBoolToVisibility}}"
                                                 Margin="0,2,0,0" Background="#3A3A3A" Foreground="#CCC"
                                                 BorderBrush="#555" Padding="4,2" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 未选中提示 -->
                    <TextBlock Text="选择一个节点查看属性"
                               Foreground="#666" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelectedNode, Converter={StaticResource InverseBoolToVisibility}}" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>